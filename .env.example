# ─── Server Configuration ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/medichain
MONGO_URI=mongodb://localhost:27017/medichain

# JWT Secret for authentication
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters

# AES-256-GCM symmetric key for off-chain file encryption (32 bytes = 64 hex characters)
FILE_ENCRYPTION_KEY=replace_with_32_byte_hex_string_64_characters

# Client CORS origin
CLIENT_ORIGIN=http://localhost:3000

# ─── Blockchain Configuration ───────────────────────────────────────────────
# Local Hardhat RPC node
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337

# Deployed MedicalRecords smart contract address (from `npm run blockchain:deploy:local`)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Deployer private key (DO NOT use mainnet keys here - test accounts only)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ─── Client Configuration (Vite) ───────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_CHAIN_ID=1337
